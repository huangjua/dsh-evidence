{
  "name": "@dsh-external/dsh-evidence",
  "version": "0.1.0",
  "description": "Evidence/audit bundle toolkit: create, snapshot, verify SHA256 manifests + hash-chained receipts",
  "private": true,
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/types/index.d.ts",
  "files": [
    "lib",
    "README.md"
  ],
  "license": "BSD-3-Clause",
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "audit",
    "evidence",
    "sha256"
  ],
  "peerDependencies": {
    "@deepseek-ai/dsh-llm": "0.1.1-rc.2 || 0.1.2-alpha.3",
    "@deepseek-ai/dsh-tools": "0.1.1-rc.2 || 0.1.2-alpha.3",
    "@deepseek-ai/cordis": "4.0.1 || 4.0.2",
    "@deepseek-ai/schemastery": "3.18.1 || 3.18.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-llm": "0.1.2-alpha.3",
    "@deepseek-ai/dsh-tools": "0.1.2-alpha.3",
    "@deepseek-ai/schemastery": "3.18.2",
    "@types/node": "^24.13.3",
    "typescript": "^5.9.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test tests/core.test.mjs",
    "pack:check": "node scripts/pack-check.mjs",
    "check:dsh-contract": "node scripts/check-dsh-contract.mjs",
    "check": "npm run typecheck && npm run check:dsh-contract && npm test && npm run pack:check"
  }
